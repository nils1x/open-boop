{
  "name": "boop-vercel",
  "version": "0.1.0",
  "private": true,
  "description": "Boop agent — Vercel deployment. Telegram-based personal agent running entirely on free tiers.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npx convex dev\" \"next dev --port 3456\"",
    "dev:convex": "convex dev",
    "dev:next": "next dev --port 3456",
    "build": "next build",
    "build:debug": "vite build --config debug/vite.config.ts",
    "start": "next start",
    "deploy:convex": "convex deploy",
    "deploy:vercel": "vercel --prod",
    "setup:webhook": "bun scripts/setup-webhook.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/openai": "^3.0.65",
    "@composio/core": "^0.9.1",
    "@huggingface/transformers": "^4.2.0",
    "ai": "^6.0.191",
    "caldav-client": "^1.0.0",
    "convex": "^1.39.1",
    "croner": "^9.1.0",
    "dotenv": "^16.6.1",
    "next": "^15.5.18",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-force-graph-2d": "^1.29.1",
    "@hugeicons/react": "^1.1.6",
    "@hugeicons/core-free-icons": "^1.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "grammy": "^1.43.0",
    "vite": "^6.4.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
