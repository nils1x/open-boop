# ---- LLM Provider (OpenCode Zen) ----
# Get an API key at https://opencode.ai/auth
# OpenCode Zen gives you access to free models like DeepSeek V4 Flash Free,
# MiniMax M2.5 Free, Ring 2.6 1T Free, Big Pickle, and more.
# Also supports OpenRouter, Ollama (local), and other OpenAI-compatible endpoints.
OPENCODE_API_KEY=
LLM_PROVIDER=opencode
LLM_MODEL=deepseek-v4-flash-free

# ---- Alternative providers (uncomment to use) ----
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# LLM_MODEL=google/gemini-2.0-flash-exp:free
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ---- Telegram (messaging) ----
# 1. Create a bot via @BotFather on Telegram
# 2. Copy the token here
# 3. Set TELEGRAM_USER_ID to your Telegram user ID (so only you can talk to the bot)
#    Get it from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ---- Convex ----
# Get these by running: npx convex dev
# Convex will create a project and auto-populate your .env.local.
CONVEX_DEPLOYMENT=
CONVEX_URL=
VITE_CONVEX_URL=

# ---- Apple iCloud CalDAV (optional — Calendar / Reminders) ----
# Create an app-specific password at appleid.apple.com → Security → App-Specific Passwords.
# Use your iCloud email + that password. Enables calendar read/write and reminders.
APPLE_EMAIL=
APPLE_APP_PASSWORD=

# ---- Composio (optional integrations) ----
# Get an API key at https://app.composio.dev/developers.
# Once set, connect toolkits (Gmail, Slack, GitHub, Linear, …) from the
# Debug UI's Connections tab. Without this, chat + memory + automations still work.
COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=

# ---- Server ----
PORT=3456

# ---- Embeddings (optional — for better memory recall) ----
# Tried in order: Voyage → OpenAI → local Transformers.js (free, ~440MB one-time download).
# Leave both blank for the free local fallback.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
