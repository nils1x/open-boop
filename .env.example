# ---- LLM Provider (OpenCode Zen) ----
# Get an API key at https://opencode.ai/auth
# OpenCode Zen gives you free models like DeepSeek V4 Flash Free.
OPENCODE_API_KEY=
LLM_PROVIDER=opencode
LLM_MODEL=deepseek-v4-flash-free

# ---- Alternative providers (uncomment to use) ----
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# LLM_MODEL=google/gemini-2.0-flash-exp:free
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ---- API Auth ----
# Shared secret for protecting all API routes.
# Generate with: openssl rand -hex 32
# Used as Authorization: Bearer <key> on all routes except the Telegram webhook.
# The Telegram webhook uses this as its secret_token instead (sent via
# X-Telegram-Bot-Api-Secret-Token header, configured during webhook setup).
API_SECRET_KEY=

# ---- Telegram (messaging) ----
# 1. Create a bot via @BotFather on Telegram
# 2. Copy the token here
# 3. Set TELEGRAM_USER_ID to your Telegram user ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ---- Convex ----
# Get these by running: npx convex dev
CONVEX_DEPLOYMENT=
CONVEX_URL=

# ---- Debug Dashboard ----
# The production Convex URL, needed at build time for the debug dashboard.
# Set this in Vercel environment variables when deploying.
# VITE_CONVEX_URL=https://sensible-poodle-943.convex.cloud

# ---- Apple iCloud CalDAV (optional) ----
APPLE_EMAIL=
APPLE_APP_PASSWORD=

# ---- Composio (optional integrations) ----
COMPOSIO_API_KEY=

# ---- Vercel ----
# Your Vercel deployment URL (without https://)
# Used by the webhook setup script
VERCEL_URL=

# ---- Embeddings (optional) ----
# Leave blank for free local fallback
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
